# Copy to .env and adjust. Defaults match willfolks-database/docker-compose.yml.
PORT=3000
# 127.0.0.1 is enough for the Android emulator (10.0.2.2) and `adb reverse`.
# Use 0.0.0.0 only to reach the API from a phone on your LAN.
HOST=127.0.0.1
DATABASE_URL=postgres://willfolks:willfolks@127.0.0.1:5432/willfolks
JWT_SECRET=change-me-local-dev-secret
# Passwordless login by email. Development only: anyone who can reach the API can sign in as anyone.
AUTH_DEV_LOGIN=true
# auto-approve: every proof with a photo is approved (stand-in for the Gemini judge).
# manual: proofs stay pending until someone calls PATCH /proofs/:id.
AI_VERIFIER_MODE=auto-approve
# Base URL the app uses to load uploaded images. Leave empty to return relative paths.
PUBLIC_URL=

# --- Cadena: Monad testnet (fase 1). Con CHAIN_ENABLED=false todo sigue simulado. ---
CHAIN_ENABLED=false
CHAIN_NAME=monad-testnet
CHAIN_ID=10143
CHAIN_RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_EXPLORER_URL=https://testnet.monadvision.com
USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
ESCROW_ADDRESS=0x3422820Ef9FBC8e0206E4CBcB6369dBd14BE18c4
# Firma los veredictos EIP-712; su dirección debe estar en la lista de atestadores del contrato.
ATTESTOR_PRIVATE_KEY=
# Paga el gas de resolve/claim/reclaim y entrega el USDC y el gas de prueba del faucet.
TREASURY_PRIVATE_KEY=
FAUCET_USDC=3
FAUCET_GAS_MON=0.25
# Metas de N segundos para demos en testnet (0 = duran hasta endDate).
CHAIN_GOAL_SECONDS=0
CHAIN_SWEEP_MS=15000
FIAT_DEPOSIT_USDC=1

# --- TilcAI (tilcai-sdk): vault, relayer, x402 y cuentas inteligentes. Con TILCAI_ENABLED=false no se usa. ---
TILCAI_ENABLED=false
# API de tilcai-infrastructure y su clave de operador (desembolsos del vault).
TILCAI_API_URL=
TILCAI_API_KEY=
# Clave de tercero con scopes accounts:read y accounts:write (cuentas inteligentes). Sin ella se usa TILCAI_API_KEY.
TILCAI_ACCOUNTS_API_KEY=
# testnet | mainnet
TILCAI_NETWORK=testnet
# OpenZeppelin Relayer de TilcAI: envía resolve/claim/reclaim y liquida el x402 del juez de IA.
TILCAI_RELAYER_URL=
TILCAI_RELAYER_API_KEY=
TILCAI_RELAYER_ID=monad-testnet-relayer
# Cada ruta se enciende sola con su credencial y se apaga con su variable (true|false):
#   TILCAI_VAULT_FUNDS enciende juntas las dos de abajo; TILCAI_VAULT_FAUCET y TILCAI_VAULT_DEPOSITS las ajustan.
# TILCAI_VAULT_FUNDS=true
# TILCAI_VAULT_FAUCET=true       el USDC del faucet sale del vault de TilcAI (el gas sigue saliendo de la tesorería)
# TILCAI_VAULT_DEPOSITS=true     el depósito fiat lo paga el vault de TilcAI
# TILCAI_RELAY_VALIDATION=true   resolve/claim/reclaim los envía el relayer de TilcAI (el veredicto lo firma este backend)
# TILCAI_AI_JUDGE=false          el juez de IA se cobra por x402 en USDC de Monad
# Compra de USDC con QR boliviano: TilcAI emite el QR por la API de Vendis (por defecto, TILCAI_API_URL/mock/vendis).
TILCAI_QR_EMAIL=
TILCAI_QR_PASSWORD=
# TILCAI_QR_URL=
# TILCAI_QR_DEVICE_ID=willfolks
QR_BOB_PER_USD=11.89
# QR_MIN_USDC=1
# QR_MAX_USDC=10
# QR_EXPIRES_MINUTES=15
AI_JUDGE_PRICE=0.01
# Quien cobra por juzgar (por defecto, la dirección del atestador) y dónde vive el juez (por defecto, este servidor).
# AI_JUDGE_PAYTO=
# AI_JUDGE_URL=
